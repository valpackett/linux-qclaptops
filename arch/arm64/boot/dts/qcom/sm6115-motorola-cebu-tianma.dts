/dts-v1/;

#include "sm6115-motorola-cebu.dtsi"

/ {
	model = "Motorola Moto G9 Power (Tianma)";
	compatible = "motorola,cebu-tianma", "motorola,cebu", "qcom,sm6115";
};

&dispcc {
	/* Preserve the bootloader display until the native panel is supported */
	status = "disabled";
};
